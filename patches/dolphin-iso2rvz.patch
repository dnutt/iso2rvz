diff --git a/dolphin/Source/Core/Common/StringUtil.cpp b/dolphin/Source/Core/Common/StringUtil.cpp
index 6a49847..c791fe6 100644
--- a/dolphin/Source/Core/Common/StringUtil.cpp
+++ b/dolphin/Source/Core/Common/StringUtil.cpp
@@ -650,6 +650,14 @@ ReEncodeString(std::basic_string_view<InputCharType> input)
   Decoder decoder{std::span{input}.first(input_size)};
 
   std::basic_string<ResultCharType> result;
+#if defined(ISO2RVZ) && !defined(__cpp_lib_string_resize_and_overwrite)
+  // iso2rvz: fallback for standard libraries without resize_and_overwrite (libstdc++ < 12).
+  result.resize(buffer_size);
+  auto* position = result.data();
+  while (decoder.RemainingCodeUnits() != 0)
+    position += encoder(decoder(), position);
+  result.resize(position - result.data());
+#else
   result.resize_and_overwrite(buffer_size, [&](ResultCharType* buf, std::size_t) {
     auto* position = buf;
 
@@ -658,6 +666,7 @@ ReEncodeString(std::basic_string_view<InputCharType> input)
 
     return position - buf;
   });
+#endif
 
   return result;
 }
